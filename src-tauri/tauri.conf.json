{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nether",
  "version": "0.1.2",
  "identifier": "com.cluvexstudio.nether",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Nether",
        "width": 980,
        "height": 660,
        "minWidth": 840,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/xray"],
    "resources": ["resources/xray/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Aether GUI client",
    "longDescription": "Nether is a simple, multi-platform desktop client for Aether, exposing its encrypted tunnel as a local SOCKS5 proxy."
  }
}
