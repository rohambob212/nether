{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "clipboard-manager:allow-write-text",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/xray",
          "sidecar": true,
          "args": [
            { "validator": "run" },
            { "validator": "-c" },
            { "validator": "\\S+" }
          ]
        }
      ]
    }
  ]
}
